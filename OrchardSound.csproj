<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SelfContained>false</SelfContained>
    <AssemblyName>LoopEdit</AssemblyName>
    <Product>$(AssemblyName)</Product>
    <Title>$(AssemblyName)</Title>
    <Description>Multitrack audio editing, loops and effects.</Description>
    <Copyright>Copyright (c) 2026 djorchard</Copyright>
    <ApplicationIcon>assets/loopedit.ico</ApplicationIcon>
    <Version>1.3.9</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <Compile Remove="tests/**/*.cs" />
    <EmbeddedResource Include="assets/loopedit.ico" LogicalName="$(AssemblyName).AppIcon" />
    <EmbeddedResource Include="assets/loopedit-wordmark.png" LogicalName="$(AssemblyName).Wordmark" />
    <None Update="LICENSE;licenses/NAudio.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
